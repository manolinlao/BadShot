{
  "name": "badshot",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev:*\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/web && npm run build -w apps/api",
    "test": "npm run test --workspaces",
    "format": "prettier --write .",
    "typecheck:web": "npm run typecheck -w apps/web",
    "lint": "npm run lint -w apps/web"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "prettier": "^3.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
